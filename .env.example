# ============================================================
# INTYRASENSE environment variables
# Copy this file to .env and fill in values:
# cp .env.example .env
# ============================================================

# ------------------------------
# Backend (FastAPI)
# ------------------------------
# Groq API key — get one free at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Supabase project URL and API key
# Used by backend/main.py, backend/supabase_client.py
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_supabase_key_here

# ------------------------------
# Frontend (Streamlit)
# ------------------------------
# Backend base URL used by frontend/app.py
# For local development: http://localhost:8000
# For Docker Compose: http://backend:8000 (set automatically)
BACKEND_URL=http://localhost:8000

# ------------------------------
# Celery & Redis (Task Queue)
# ------------------------------
# Set to true to use Celery for async ingestion.
# Falls back to in-process thread if false or if Redis is unreachable.
USE_CELERY=true

# Redis connection URL — used for Celery broker, result backend, and ingestion state.
# For local Redis: redis://localhost:6379/0
# For Upstash (cloud): rediss://default:YOUR_PASSWORD@YOUR_ENDPOINT.upstash.io:6379
# TLS (rediss://) is auto-configured — no extra SSL setup needed.
REDIS_URL=redis://localhost:6379/0

# Optional: override broker/backend separately (defaults to REDIS_URL if omitted)
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0
